{
  "name": "nipige-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rimraf .next node_modules/.cache",
    "predev": "npm run clean",
    "prebuild": "npm run clean",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node ./scripts/postbuild.js",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:prices": "node ./scripts/check-price-literals.js"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "gray-matter": "4.0.3",
    "image-size": "^2.0.2",
    "next": "^15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-google-recaptcha": "^3.1.0",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/react-google-recaptcha": "^2.1.9",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-config-next": "^15.5.19",
    "postcss": "8.5.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom"
  },
