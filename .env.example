# Optional override for the upstream forms API base URL (server-side only).
# If unset, the default AWS endpoint is used automatically.
# FORMS_API_BASE_URL=https://8kgtju0kg2.execute-api.ap-south-1.amazonaws.com

# reCAPTCHA v2 "I'm not a robot" checkbox for the contact/demo/agency forms.
# Get keys at https://www.google.com/recaptcha/admin - register a site with
# type "reCAPTCHA v2" -> "I'm not a robot" Checkbox (NOT v3 - the two key
# types aren't interchangeable). If unset, the forms skip the checkbox and
# submit without it.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# Upstash Redis, used to rate-limit the forms API route (3 submissions/min/IP,
# coordinated across all server instances). Get these from an Upstash Redis
# database's REST API tab: https://console.upstash.com
# If unset, a weaker per-process in-memory fallback is used instead.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
